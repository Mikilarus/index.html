<!DOCTYPE html>
<html>
<head>
<style>
body {
font-family: Arial;
background: #d0df28;
}

.color {
display: inline-block;
width: 100px;
height: 100px;
margin: 10px;
box-shadow: 0 5px 10px gray;
transition: 0.3s;
}

.color:hover {
transform: scale(1.1);
}

.red { background: rgb(232, 132, 132); }
.blue { background: rgb(126, 185, 234); }
.green { background: rgb(4, 97, 4); }

.hero {
padding: 80px;
text-align: center;
color: white;
background:
linear-gradient(rgba(0,0,255,0.5), rgba(255,0,0,0.5)),
url("https://t4.ftcdn.net/jpg/05/31/37/99/360_F_531379957_eLlw7pVpqE2LuoGPeMqyVMT83tRUvwzN.jpg");
background-size: cover;
background-position: center;
}

.glass {
margin: 40px auto;
padding: 30px;
width: 200px;
text-align: center;
background: rgba(255,255,255,0.3);
backdrop-filter: blur(10px);
border-radius: 15px;
box-shadow: 0 5px 15px gray;
}
</style>
</head>

<body>

<h2>Тест на дальтоника</h2>
<div class="color red"></div>
<div class="color blue"></div>
<div class="color green"></div>

<div class="hero">
<h1>Мой сайт</h1>
<p>Какой то мужик</p>
</div>

<div class="glass">
<h2>Эффект стекла</h2>
<p>Я надеюсь</p>
</div>

</body>
</html>
